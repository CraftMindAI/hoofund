// Prisma schema for Hoofund. Docs: https://pris.ly/d/prisma-schema
//
// Login (email + password) is handled by Firebase Authentication.
// The password is never stored here; this table holds the profile details
// collected at sign-up, linked to the Firebase account by `firebaseUid`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The connection URL lives in prisma.config.ts (read from .env), as Prisma 7 requires.
datasource db {
  provider = "mysql"
}

enum Role {
  USER
  ADMIN
}

model User {
  /// 1, 2, 3, … in the order users join.
  id          Int      @id @default(autoincrement())
  firebaseUid String   @unique @map("firebase_uid") @db.VarChar(128)
  name        String   @db.VarChar(100)
  email       String   @unique @db.VarChar(255)
  /// Stored in E.164 format, e.g. +919876543210. The sign-up form always
  /// asks for phone and location; they are optional here only so an admin
  /// account can be created by hand without them.
  phone       String?  @unique @db.VarChar(20)
  location    String?  @db.VarChar(160)
  /// Set on the server only; never accepted from the sign-up form.
  role        Role     @default(USER)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  /// The plans this user has joined (see UserPlan.planIds).
  userPlan    UserPlan?

  @@map("users")
}

/// Partner plans shown on the landing page and account page.
/// Amounts are whole rupees (85000 = ₹85,000).
model Plan {
  id             Int      @id @default(autoincrement())
  /// Display order; also the number shown as "Plan 1", "Plan 2", …
  sortOrder      Int      @unique @map("sort_order")
  cows           Int
  investment     Int
  /// Paid for 9 months each year.
  monthlyPayment Int      @map("monthly_payment")
  /// Total the partner receives over 5 years.
  totalReturn    Int      @map("total_return")
  /// Highlighted card with the "Largest plan" badge.
  featured       Boolean  @default(false)
  /// Hidden from the site when false.
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("plans")
}

/// Which plans each user has: one row per user, with the plan ids as a
/// JSON array, e.g. [1, 3]. MySQL can't check ids inside JSON, so the app
/// only saves ids that exist in `plans` (see setUserPlans).
model UserPlan {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  /// Plan ids (plans.id), sorted, e.g. [1, 3].
  planIds   Json     @map("plan_ids")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Deleting a user removes their row.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_plans")
}
